---
const servicesColombia = [
  {
    icon: 'ph ph-laptop',
    title: 'Visa de Nómada Digital',
    description: 'Para profesionales independientes y trabajadores remotos que viven en Colombia.'
  },
  {
    icon: 'ph ph-airplane',
    title: 'Visas de Visitante (Tipo V)',
    description: 'Turismo, tránsito, tratamientos médicos, eventos y actividades académicas.'
  },
  {
    icon: 'ph ph-house',
    title: 'Visas de Migrante (Tipo M)',
    description: 'Por matrimonio, inversión, trabajo o profesionales calificados.'
  },
  {
    icon: 'ph ph-users-three',
    title: 'Visas de Negocios',
    description: 'Constitución de empresas, representación legal y operaciones comerciales.'
  },
  {
    icon: 'ph ph-identification-card',
    title: 'Cédula de Extranjería',
    description: 'Identificación para extranjeros residentes en Colombia.'
  }
];
---

<section id="services-colombia" class="py-24 bg-gradient-to-br from-surface via-background to-surface relative overflow-hidden">
  <div class="absolute inset-0 opacity-40">
    <div class="absolute bottom-20 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-mobile sm:px-margin-desktop relative z-10">
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-1.5 rounded-full font-label-sm text-sm mb-4">
        <i class="ph ph-globe text-xl"></i>
        COLOMBIA
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Asesoría Legal Migratoria Colombia</h2>
      <div class="w-16 h-1 bg-primary mx-auto rounded-full mb-6"></div>
      <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Cumplimiento con los requisitos de la Cancillería de Colombia
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {servicesColombia.map((service, i) => (
        <div 
          class="group bg-white border border-outline-variant/50 p-6 rounded-2xl shadow-card hover:shadow-card-hover hover:border-primary/30 hover:-translate-y-2 transition-all duration-500"
          style={`animation-delay: ${i * 0.1}s`}
        >
          <div class="w-14 h-14 bg-primary/10 group-hover:bg-primary rounded-xl flex items-center justify-center mb-5 transition-all duration-300 group-hover:scale-110">
            <i class={`${service.icon} text-2xl text-primary group-hover:text-white transition-colors duration-300`}></i>
          </div>
          <h3 class="font-headline-md text-headline-md text-primary mb-3">{service.title}</h3>
          <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>