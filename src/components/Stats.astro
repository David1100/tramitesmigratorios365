---
const stats = [
  { value: '2500+', label: 'Clientes Felices', icon: 'ph ph-users' },
  { value: '1500+', label: 'Residencias Aprobadas', icon: 'ph ph-check-circle' },
  { value: '10+', label: 'Años de Experiencia', icon: 'ph ph-trophy' }
];
---

<section class="py-20 bg-gradient-to-r from-primary via-primary-dark to-primary text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-white rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-white/50 rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-desktop relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      {stats.map((stat, i) => (
        <div 
          class="py-8 px-4 transition-all duration-700"
          style={`animation-delay: ${i * 0.15}s`}
        >
          <div class="w-20 h-20 mx-auto rounded-2xl bg-white/10 backdrop-blur-sm flex items-center justify-center mb-4">
            <i class={`${stat.icon} text-3xl`}></i>
          </div>
          <div class="font-display-lg text-5xl font-bold mb-2">{stat.value}</div>
          <div class="font-label-md text-white/80 uppercase tracking-wider">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
