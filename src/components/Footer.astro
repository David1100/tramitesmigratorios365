---
const phone = '+16506791659';
const email = 'Tramitesm365@gmail.com';
const address = '333 SE 2ND AVE SUITE 2000 MIAMI FL 33131';
const businessName = 'VisaDirect';
---

<footer class="bg-primary text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 right-0 w-80 h-80 bg-white rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-mobile sm:px-margin-desktop relative z-10 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div class="animate-fade-in-up">
        <img src="/logo_blanco.webp" alt="VisaDirect Logo" class="h-24 w-auto mb-4" />
        <em class="font-body-sm text-white/70 mb-6 max-w-xs leading-relaxed">
          tu proyecto de vida al destino que mereces…
        </em>
        <div class="flex gap-3 mt-6">
          <a 
            href="https://facebook.com/visadirect" 
            target="_blank"
            rel="noopener"
            class="group w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center hover:bg-white hover:-translate-y-1 transition-all duration-300"
            aria-label="Facebook"
          >
            <i class="ph ph-facebook-logo text-xl text-white group-hover:text-primary transition-colors"></i>
          </a>
          <a 
            href="https://instagram.com/visadirect" 
            target="_blank"
            rel="noopener"
            class="group w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center hover:bg-white hover:-translate-y-1 transition-all duration-300"
            aria-label="Instagram"
          >
            <i class="ph ph-instagram-logo text-xl text-white group-hover:text-primary transition-colors"></i>
          </a>
          <a 
            href="https://tiktok.com/@visadirect" 
            target="_blank"
            rel="noopener"
            class="group w-11 h-11 rounded-xl bg-white/10 flex items-center justify-center hover:bg-white hover:-translate-y-1 transition-all duration-300"
            aria-label="TikTok"
          >
            <i class="ph ph-tiktok-logo text-xl text-white group-hover:text-primary transition-colors"></i>
          </a>
        </div>
      </div>
      <div class="animate-fade-in-up" style="animation-delay: 0.1s;">
        <h4 class="font-headline-md text-headline-md font-semibold mb-6">Contacto</h4>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <i class="ph ph-map-pin text-xl text-white/60 mt-0.5"></i>
            <span class="font-body-sm text-white/70">{address}</span>
          </div>
          <div class="flex items-center gap-3">
            <i class="ph ph-phone text-xl text-white/60"></i>
            <a href={`tel:${phone.replace('+', '')}`} class="font-body-sm text-white/70 hover:text-white transition-colors">{phone}</a>
          </div>
          <div class="flex items-center gap-3">
            <i class="ph ph-envelope text-xl text-white/60"></i>
            <a href={`mailto:${email}`} class="font-body-sm text-white/70 hover:text-white transition-colors">{email}</a>
          </div>
        </div>
      </div>
      <div class="animate-fade-in-up" style="animation-delay: 0.2s;">
        <h4 class="font-headline-md text-headline-md font-semibold mb-6">Horario de Atención</h4>
        <div class="space-y-2 mb-6">
          <p class="font-body-sm text-white/70">Lunes a Viernes: 9:00 AM - 6:00 PM</p>
          <p class="font-body-sm text-white/70">Sábados: 9:00 AM - 1:00 PM</p>
        </div>
        <a 
          href={`https://wa.me/${phone.replace('+', '')}`} 
          target="_blank" 
          rel="noopener"
          class="group inline-flex items-center gap-2 bg-secondary text-white px-6 py-3 rounded-xl font-label-md text-label-md font-semibold hover:-translate-y-1 hover:shadow-lg transition-all duration-300"
        >
          <i class="ph ph-whatsapp-logo text-xl"></i>
          WhatsApp
          <i class="ph ph-arrow-right text-xl transition-transform group-hover:translate-x-1"></i>
        </a>
      </div>
    </div>
    <div class="border-t border-white/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex flex-wrap justify-center gap-6">
        <a class="font-body-sm text-white/60 hover:text-white transition-colors" href="#">Política de Privacidad</a>
        <a class="font-body-sm text-white/60 hover:text-white transition-colors" href="#">Términos de Servicio</a>
        <a class="font-body-sm text-white/60 hover:text-white transition-colors" href="#">Aviso Legal</a>
        <a class="font-body-sm text-white/60 hover:text-white transition-colors" href="#">Política de Cookies</a>
      </div>
      <p class="font-body-sm text-white/60">
        © 2024 {businessName}. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>