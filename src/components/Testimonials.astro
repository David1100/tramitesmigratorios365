---
const testimonials = [
  {
    name: 'Carlos M.',
    location: 'Miami, FL',
    quote: 'Después de años intentándolo solo, finalmente logré mi residencia permanente. El equipo me guió en cada paso del proceso.',
    service: 'Ajuste de Estatus'
  },
  {
    name: 'María González',
    location: 'Bogotá, Colombia',
    quote: 'Obtuve mi visa de nómada digital en tiempo récord. Ahora trabajo desde Medellín para mi empresa en EE.UU. sin preocuparme.',
    service: 'Visa Nómada Digital'
  },
  {
    name: 'Roberto & Ana López',
    location: 'Orlando, FL',
    quote: 'Gracias a su asesoría, nuestra familia pudo reunirse en EE.UU.. Procesaron nuestra petición familiar con eficiencia.',
    service: 'Petición Familiar I-130'
  },
  {
    name: 'Andrea Torres',
    location: 'Cali, Colombia',
    quote: 'Me ayudaron a constituir mi LLC en Florida desde Colombia. Todo el proceso fue remoto y transparente.',
    service: 'Constitución de LLC'
  }
];
---

<section class="py-24 bg-gradient-to-br from-surface via-background to-surface relative overflow-hidden">
  <div class="absolute inset-0 opacity-40">
    <div class="absolute top-20 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-desktop relative z-10">
    <div class="text-center mb-16">
      <span class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-1.5 rounded-full font-label-sm text-sm mb-4">
        <i class="ph ph-quotes text-xl"></i>
        TESTIMONIOS
      </span>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Lo Que Dicen Nuestros Clientes</h2>
      <div class="w-16 h-1 bg-primary mx-auto rounded-full mb-6"></div>
      <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
        Historias de éxito respaldadas por nuestra dedicación. La confianza de quienes han alcanzado sus metas es nuestro mayor orgullo.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {testimonials.map((t, i) => (
        <div 
          class="group bg-white p-6 rounded-2xl shadow-card hover:shadow-card-hover hover:-translate-y-2 transition-all duration-500 flex flex-col h-full"
          style={`animation-delay: ${i * 0.1}s`}
        >
          <div class="flex items-center gap-3 mb-5">
            <div class="w-14 h-14 bg-gradient-to-br from-primary to-primary-dark rounded-full flex items-center justify-center text-white font-bold text-lg shadow-lg group-hover:scale-105 transition-transform duration-300">{t.name.split(' ').map(n => n[0]).join('')}</div>
            <div>
              <div class="font-label-md text-on-surface font-semibold">{t.name}</div>
              <div class="font-label-sm text-on-surface-variant">{t.location}</div>
            </div>
          </div>
          <p class="font-body-sm text-body-sm text-on-surface flex-grow leading-relaxed italic mb-5">"{t.quote}"</p>
          <div class="border-t border-outline-variant/50 pt-4">
            <span class="inline-flex items-center gap-1 text-primary font-label-sm group-hover:text-primary-dark transition-colors">
              <i class="ph ph-check-circle text-sm"></i>
              {t.service}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>