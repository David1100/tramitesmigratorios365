---
---

<section class="relative min-h-[850px] flex items-center bg-gradient-to-br from-surface via-background to-surface overflow-hidden">
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl animate-float"></div>
    <div class="absolute bottom-20 right-20 w-96 h-96 bg-primary/10 rounded-full blur-3xl animate-float" style="animation-delay: 1.5s;"></div>
  </div>
  
  <div class="max-w-container-max mx-auto px-margin-mobile sm:px-margin-desktop grid grid-cols-1 md:grid-cols-2 gap-16 items-center w-full relative z-10">
    <div class="animate-fade-in-up">
      <div class="inline-flex items-center gap-2 bg-primary/10 text-primary px-4 py-2 rounded-full mb-6">
        <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
        <span class="font-label-sm text-sm">+10 años guiando sueños migratorios</span>
      </div>
      <h1 class="font-display-lg text-display-lg text-primary mb-6 leading-tight">
        El respaldo experto <br/>
        <span class="text-primary-dark">que tus trámites necesitan</span>
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-8 max-w-lg leading-relaxed">
        Logramos que tus trámites Migratorios en Estados Unidos y Colombia se gestionen con la rigurosidad y el éxito que mereces.
      </p>
      <div class="flex flex-wrap gap-4">
        <a 
          href="#services"
          class="group bg-primary text-white px-8 py-4 rounded-xl font-label-md text-label-md font-semibold shadow-button hover:shadow-button-hover hover:-translate-y-1 active:translate-y-0 transition-all duration-300 flex items-center gap-2"
        >
          Explorar Servicios
          <i class="ph ph-arrow-right text-xl" style="transition: transform 0.3s;"></i>
        </a>
        <a 
          href="https://wa.me/16506791659"
          target="_blank"
          rel="noopener"
          class="group bg-white text-primary border-2 border-primary px-8 py-4 rounded-xl font-label-md text-label-md font-semibold hover:bg-primary hover:text-white transition-all duration-300 flex items-center gap-2"
        >
          <i class="ph ph-whatsapp-logo text-xl"></i>
          WhatsApp
        </a>
      </div>
      <div class="mt-12 flex items-center gap-8">
        <div class="flex -space-x-3">
          <div class="w-10 h-10 rounded-full bg-primary/20 border-2 border-white flex items-center justify-center text-xs font-bold text-primary">MG</div>
          <div class="w-10 h-10 rounded-full bg-primary/20 border-2 border-white flex items-center justify-center text-xs font-bold text-primary">CL</div>
          <div class="w-10 h-10 rounded-full bg-primary/20 border-2 border-white flex items-center justify-center text-xs font-bold text-primary">AT</div>
          <div class="w-10 h-10 rounded-full bg-primary/20 border-2 border-white flex items-center justify-center text-xs font-bold text-primary">+</div>
        </div>
        <div>
          <p class="font-label-md text-on-surface font-semibold">+2500 Clientes Felices</p>
          <p class="font-label-sm text-on-surface-variant">y contando...</p>
        </div>
      </div>
    </div>
    <div class="relative hidden md:block animate-fade-in" style="animation-delay: 0.3s;">
      <div class="relative">
        <div class="absolute -inset-4 bg-gradient-to-br from-primary to-primary-dark rounded-3xl blur-2xl opacity-20 animate-pulse"></div>
        <div class="relative rounded-2xl overflow-hidden shadow-2xl transform hover:scale-[1.02] transition-transform duration-500">
          <img 
            alt="Professional immigration consultants" 
            class="w-full h-[550px] object-cover" 
            src="https://images.unsplash.com/photo-1521791136064-7986c2920216?w=800&q=80" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-primary/30 to-transparent"></div>
        </div>
      </div>
      <div class="absolute -bottom-8 -left-8 bg-white p-5 rounded-2xl shadow-xl animate-float">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
            <i class="ph ph-seal-check text-2xl" style="color: #1e2849;"></i>
          </div>
          <div>
            <span class="font-display-lg text-display-lg text-primary font-bold">99.9%</span>
            <p class="font-label-sm text-on-surface-variant">Tasa de Aprobación</p>
          </div>
        </div>
      </div>
      <div class="absolute -top-4 -right-4 bg-primary text-white p-4 rounded-xl shadow-xl animate-float">
        <i class="ph ph-trophy text-2xl"></i>
      </div>
    </div>
  </div>
  <div class="absolute bottom-0 sm:bottom-4 -translate-x-1/2 animate-bounce w-full">
    <a href="#services" class="flex flex-col items-center gap-2 text-on-surface-variant hover:text-primary transition-colors">
      <span class="font-label-sm">Descubre más</span>
      <i class="ph ph-caret-down text-xl"></i>
    </a>
  </div>
</section>