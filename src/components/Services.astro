---
const services = [
  {
    image: '/banderas/eeuu.png',
    title: 'Trámites Estados Unidos',
    description: 'Peticiones familiares, ajuste de estatus, naturalización, visas de prometido, autorización de empleo y constitución de empresas.',
    link: '#services-usa'
  },
  {
    image: '/banderas/colombia.png',
    title: 'Asesoría Legal Colombia',
    description: 'Visa de nómada digital, visas de visitante, migrante, negocios y cédula de extranjería.',
    link: '#services-colombia'
  }
];
---

<section id="services" class="py-24 bg-background relative overflow-hidden">
  <div class="absolute inset-0 opacity-50">
    <div class="absolute top-0 right-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl"></div>
  </div>
  <div class="max-w-container-max mx-auto px-margin-mobile sm:px-margin-desktop relative z-10">
    <div class="text-center mb-16">
      <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full font-label-sm text-sm mb-4">NUESTROS SERVICIOS</span>
      <h2 class="font-headline-lg text-headline-lg text-primary mb-4">Soluciones para Cada Necesidad</h2>
      <div class="w-16 h-1 bg-primary mx-auto rounded-full mb-6"></div>
      <p class="font-body-lg text-on-surface-variant max-w-2xl mx-auto">
        Servicios especializados en migraciones internacionales para Estados Unidos y Colombia
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      {services.map((service, i) => (
        <a 
          href={service.link}
          class="group bg-white border-2 border-transparent p-8 rounded-2xl shadow-card hover:shadow-card-hover hover:border-primary/20 hover:-translate-y-2 transition-all duration-500"
          style={`animation-delay: ${i * 0.15}s`}
        >
          <div class="w-16 h-16 bg-primary/10 group-hover:bg-primary rounded-2xl flex items-center justify-center mb-6 transition-all duration-300 group-hover:scale-110 overflow-hidden">
            <img src={service.image} alt={service.title} class="w-10 h-10 object-contain">
          </div>
          <h3 class="font-headline-md text-headline-md text-primary mb-3 transition-colors">{service.title}</h3>
          <p class="font-body-md text-on-surface-variant mb-6 leading-relaxed">{service.description}</p>
          <div class="flex items-center gap-2 font-label-md font-semibold text-primary group-hover:gap-4 transition-all duration-300">
            Ver servicios
            <i class="ph ph-arrow-right text-xl transition-transform group-hover:translate-x-2"></i>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>